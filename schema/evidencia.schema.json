{
 "type": "array",
 "items": {
  "type": "object",
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9-]*$"
   },
   "afirmacao": {
    "type": "string",
    "minLength": 1
   },
   "quem": {
    "type": "string",
    "minLength": 1
   },
   "veredito": {
    "enum": [
     "nao-sustentado",
     "quase-sem-evidencia",
     "pontual",
     "plausivel",
     "sustentado"
    ]
   },
   "secao": {
    "type": "string",
    "minLength": 1
   },
   "a_favor": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    },
    "minItems": 1
   },
   "contra": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    },
    "minItems": 1
   }
  },
  "required": [
   "id",
   "afirmacao",
   "quem",
   "veredito",
   "secao",
   "a_favor",
   "contra"
  ],
  "additionalProperties": false
 },
 "minItems": 1,
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}
